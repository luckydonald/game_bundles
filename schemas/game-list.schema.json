{
  "$defs": {
    "Game": {
      "additionalProperties": false,
      "description": "A named game with one or more storefront identities.",
      "properties": {
        "group": {
          "anyOf": [
            {
              "$ref": "#/$defs/GameGroup"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Ids",
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "requires": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Requires",
          "type": "array"
        },
        "tiers": {
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "title": "Tiers",
          "type": "array"
        }
      },
      "required": [
        "name",
        "ids"
      ],
      "title": "Game",
      "type": "object"
    },
    "GameGroup": {
      "additionalProperties": false,
      "description": "Provenance link for Games split out of one compound source offer.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "GameGroup",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "description": "A local/repository file or web source supporting a game list.",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "format": "file-path",
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "name"
      ],
      "title": "Reference",
      "type": "object"
    },
    "TierDefinition": {
      "additionalProperties": false,
      "description": "One purchase variation (\"tier\") of a bundle list.",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "pick_quota": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pick Quota"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        }
      },
      "required": [
        "rank",
        "name"
      ],
      "title": "TierDefinition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The complete, current-shape (v2) contents of one ``lists/**/*.yml`` file.\n\nVersioning lives outside this model - see `GAMELIST_V1`/`GAMELIST_V2`/`GameListV1`/\n`VersionedGameList` above and `migrations/list_versions.py` - a v1 file (one\nnot-yet-merged tier/pick-variation) validates as `GameListV1` instead, never as this.",
  "properties": {
    "crawlers": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Crawlers",
      "type": "array"
    },
    "games": {
      "items": {
        "$ref": "#/$defs/Game"
      },
      "minItems": 1,
      "title": "Games",
      "type": "array"
    },
    "invalid": {
      "items": {
        "$ref": "#/$defs/Game"
      },
      "title": "Invalid",
      "type": "array"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "pick_quota": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pick Quota"
    },
    "references": {
      "items": {
        "$ref": "#/$defs/Reference"
      },
      "title": "References",
      "type": "array"
    },
    "tiers": {
      "items": {
        "$ref": "#/$defs/TierDefinition"
      },
      "title": "Tiers",
      "type": "array"
    }
  },
  "required": [
    "name",
    "games"
  ],
  "title": "GameList",
  "type": "object"
}
