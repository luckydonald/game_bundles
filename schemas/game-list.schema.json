{
  "$defs": {
    "Game": {
      "additionalProperties": false,
      "description": "A named game with one or more storefront identities.",
      "properties": {
        "group": {
          "anyOf": [
            {
              "$ref": "#/$defs/GameGroup"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Ids",
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "ids"
      ],
      "title": "Game",
      "type": "object"
    },
    "GameGroup": {
      "additionalProperties": false,
      "description": "Provenance link for Games split out of one compound source offer.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "GameGroup",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "description": "A local/repository file or web source supporting a game list.",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "format": "file-path",
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "name"
      ],
      "title": "Reference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The complete contents of one ``lists/**/*.yml`` file.",
  "properties": {
    "games": {
      "items": {
        "$ref": "#/$defs/Game"
      },
      "minItems": 1,
      "title": "Games",
      "type": "array"
    },
    "invalid": {
      "items": {
        "$ref": "#/$defs/Game"
      },
      "title": "Invalid",
      "type": "array"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "pick_quota": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pick Quota"
    },
    "references": {
      "items": {
        "$ref": "#/$defs/Reference"
      },
      "title": "References",
      "type": "array"
    },
    "schema": {
      "const": 1,
      "title": "Schema",
      "type": "integer"
    },
    "tier": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tier"
    }
  },
  "required": [
    "schema",
    "name",
    "games"
  ],
  "title": "GameList",
  "type": "object"
}
