{
  "$defs": {
    "DigDates": {
      "additionalProperties": false,
      "description": "Offer observation timestamp and its estimated expiry.\n\n`start`: no known source on DIG's pages - left `None`, never fabricated. `end` is\n*computed* (`crawled + parsed \"ends in Xd:Xh:Xm:Xs\"` countdown) - real countdown\ntext, but a derived, second-precision-drifting estimate, hence a confidence well\nbelow 1.0. `first_seen` is set once, the first time this bundle is ever archived,\nand never overwritten afterward.",
      "properties": {
        "crawled": {
          "format": "date-time",
          "title": "Crawled",
          "type": "string"
        },
        "end": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScrapedTimestamp"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "first_seen": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Seen"
        },
        "start": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScrapedTimestamp"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "crawled"
      ],
      "title": "DigDates",
      "type": "object"
    },
    "DigItem": {
      "additionalProperties": false,
      "description": "One Steam game advertised within a DIG bundle.",
      "properties": {
        "cover_art_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cover Art Url"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Ids",
          "type": "array"
        },
        "individual_price": {
          "anyOf": [
            {
              "$ref": "#/$defs/DigPrice"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "region": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "title",
        "ids",
        "url"
      ],
      "title": "DigItem",
      "type": "object"
    },
    "DigPrice": {
      "additionalProperties": false,
      "description": "A USD price as displayed on the site.",
      "properties": {
        "currency": {
          "minLength": 1,
          "title": "Currency",
          "type": "string"
        },
        "currency_code": {
          "minLength": 1,
          "title": "Currency Code",
          "type": "string"
        },
        "raw": {
          "minLength": 1,
          "title": "Raw",
          "type": "string"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "raw",
        "value",
        "currency",
        "currency_code"
      ],
      "title": "DigPrice",
      "type": "object"
    },
    "ScrapedTimestamp": {
      "additionalProperties": false,
      "description": "One `start`/`end` value as actually derived from a source, plus how sure we are.\n\n`iso` preserves whatever precision the source gave us (date-only, or date+time\ndown to minute/second/fraction, always with an explicit UTC offset unless it's\ndate-only); `timestamp` is the same instant as a unix epoch float, cross-checked\nagainst `iso` on construction so the two can never silently drift apart.",
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "iso": {
          "minLength": 1,
          "title": "Iso",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceName"
        },
        "timestamp": {
          "title": "Timestamp",
          "type": "number"
        }
      },
      "required": [
        "iso",
        "timestamp",
        "confidence",
        "source"
      ],
      "title": "ScrapedTimestamp",
      "type": "object"
    },
    "SourceName": {
      "description": "One entry per `sources/<name>/` crawler package.",
      "enum": [
        "humblebundle",
        "greenmangaming",
        "dailyindiegame",
        "isthereanydeal",
        "dekudeals"
      ],
      "title": "SourceName",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Normalized metadata for one DailyIndieGame weekly bundle.",
  "properties": {
    "bundle_price": {
      "$ref": "#/$defs/DigPrice"
    },
    "dates": {
      "$ref": "#/$defs/DigDates"
    },
    "game_count": {
      "minimum": 0,
      "title": "Game Count",
      "type": "integer"
    },
    "is_adult": {
      "title": "Is Adult",
      "type": "boolean"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/DigItem"
      },
      "minItems": 1,
      "title": "Items",
      "type": "array"
    },
    "kind": {
      "const": "bundle",
      "default": "bundle",
      "title": "Kind",
      "type": "string"
    },
    "machine_name": {
      "minLength": 1,
      "title": "Machine Name",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "savings_amount": {
      "$ref": "#/$defs/DigPrice"
    },
    "savings_percent": {
      "maximum": 100,
      "minimum": 0,
      "title": "Savings Percent",
      "type": "integer"
    },
    "total_value": {
      "$ref": "#/$defs/DigPrice"
    },
    "url": {
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "title": "Url",
      "type": "string"
    }
  },
  "required": [
    "machine_name",
    "url",
    "name",
    "is_adult",
    "dates",
    "game_count",
    "total_value",
    "bundle_price",
    "savings_percent",
    "savings_amount",
    "items"
  ],
  "title": "DigArchive",
  "type": "object"
}
