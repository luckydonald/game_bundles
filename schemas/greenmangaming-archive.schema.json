{
  "$defs": {
    "GmgDates": {
      "additionalProperties": false,
      "description": "Offer availability and observation timestamps.\n\n`start`: no known source on GMG's pages - left `None`, never fabricated. `end`\ncomes from the bundles index page's own `data-end-date=\"YYYY-MM-DDTHH:MM\"` (no\nexplicit UTC offset - assumed to already be UTC, unconfirmed against the server,\nhence a confidence below 1.0 rather than 1.0). `first_seen` is set once, the first\ntime this bundle is ever archived, and never overwritten afterward.",
      "properties": {
        "crawled": {
          "format": "date-time",
          "title": "Crawled",
          "type": "string"
        },
        "end": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScrapedTimestamp"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "first_seen": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Seen"
        },
        "start": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScrapedTimestamp"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "crawled"
      ],
      "title": "GmgDates",
      "type": "object"
    },
    "GmgItem": {
      "additionalProperties": false,
      "description": "One product advertised within a Green Man Gaming bundle tier.",
      "properties": {
        "cover_art_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cover Art Url"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "developer": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Developer"
        },
        "drm": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Drm"
        },
        "platform": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Platform"
        },
        "product_id": {
          "minLength": 1,
          "title": "Product Id",
          "type": "string"
        },
        "publisher": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publisher"
        },
        "redeem_on": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Redeem On",
          "type": "array"
        },
        "resolution": {
          "$ref": "#/$defs/GmgResolution"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "product_id",
        "title"
      ],
      "title": "GmgItem",
      "type": "object"
    },
    "GmgPrice": {
      "additionalProperties": false,
      "description": "A localized price with its unambiguous ISO currency code.",
      "properties": {
        "currency": {
          "minLength": 1,
          "title": "Currency",
          "type": "string"
        },
        "currency_code": {
          "minLength": 1,
          "title": "Currency Code",
          "type": "string"
        },
        "raw": {
          "minLength": 1,
          "title": "Raw",
          "type": "string"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "raw",
        "value",
        "currency",
        "currency_code"
      ],
      "title": "GmgPrice",
      "type": "object"
    },
    "GmgResolution": {
      "additionalProperties": false,
      "description": "Storefront identity resolution for one archived item.\n\n`ids` describes the item as a single game (the common case). When the\nuser declares via \"Multiple\u2026\" that one item is actually several separate\ngames, `splits` holds one resolved entry per game instead, and `ids` is\nleft empty.",
      "properties": {
        "ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Ids",
          "type": "array"
        },
        "splits": {
          "items": {
            "$ref": "#/$defs/GmgResolvedGame"
          },
          "title": "Splits",
          "type": "array"
        },
        "unresolved_stores": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Unresolved Stores",
          "type": "array"
        }
      },
      "title": "GmgResolution",
      "type": "object"
    },
    "GmgResolvedGame": {
      "additionalProperties": false,
      "description": "One game split out of a compound item via the \"Multiple\u2026\" resolution prompt.",
      "properties": {
        "ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Ids",
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "GmgResolvedGame",
      "type": "object"
    },
    "GmgTier": {
      "additionalProperties": false,
      "description": "A cumulative Green Man Gaming purchase tier.",
      "properties": {
        "identifier": {
          "minLength": 1,
          "title": "Identifier",
          "type": "string"
        },
        "item_count": {
          "minimum": 0,
          "title": "Item Count",
          "type": "integer"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/GmgItem"
          },
          "title": "Items",
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "price": {
          "anyOf": [
            {
              "$ref": "#/$defs/GmgPrice"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "identifier",
        "name",
        "item_count",
        "items"
      ],
      "title": "GmgTier",
      "type": "object"
    },
    "ScrapedTimestamp": {
      "additionalProperties": false,
      "description": "One `start`/`end` value as actually derived from a source, plus how sure we are.\n\n`iso` preserves whatever precision the source gave us (date-only, or date+time\ndown to minute/second/fraction, always with an explicit UTC offset unless it's\ndate-only); `timestamp` is the same instant as a unix epoch float, cross-checked\nagainst `iso` on construction so the two can never silently drift apart.",
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "iso": {
          "minLength": 1,
          "title": "Iso",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceName"
        },
        "timestamp": {
          "title": "Timestamp",
          "type": "number"
        }
      },
      "required": [
        "iso",
        "timestamp",
        "confidence",
        "source"
      ],
      "title": "ScrapedTimestamp",
      "type": "object"
    },
    "SourceName": {
      "description": "One entry per `sources/<name>/` crawler package.",
      "enum": [
        "humblebundle",
        "greenmangaming",
        "dailyindiegame",
        "isthereanydeal",
        "dekudeals"
      ],
      "title": "SourceName",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Normalized metadata for one Green Man Gaming bundle offer.",
  "properties": {
    "currency_code": {
      "minLength": 1,
      "title": "Currency Code",
      "type": "string"
    },
    "dates": {
      "$ref": "#/$defs/GmgDates"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "slug": {
      "minLength": 1,
      "title": "Slug",
      "type": "string"
    },
    "tiers": {
      "items": {
        "$ref": "#/$defs/GmgTier"
      },
      "minItems": 1,
      "title": "Tiers",
      "type": "array"
    },
    "url": {
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "title": "Url",
      "type": "string"
    }
  },
  "required": [
    "slug",
    "url",
    "name",
    "currency_code",
    "dates",
    "tiers"
  ],
  "title": "GmgArchive",
  "type": "object"
}
